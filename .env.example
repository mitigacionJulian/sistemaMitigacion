# Copie este archivo a .env en la raíz del repo y ajuste valores.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# El archivo .env no se sube a Git (.gitignore).

# --- Django ---
# DJANGO_DEBUG=1 → modo desarrollo; habilita por defecto ejecutar pruebas desde /admin/pruebas
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-aleatoria-larga
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL (misma contraseña para Docker db + backend) ---
POSTGRES_DB=mitigacion_accidentes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambie-esta-contraseña
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Si usa Postgres local fuera de Docker (ej. pgAdmin en otro puerto), descomente y ajuste:
# POSTGRES_DB=reviNuwBD
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5434

# --- CORS / CSRF (frontend Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT y recuperación de clave ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_HOURS=1

# --- Asistente IA (Gemini API, tier gratuito) ---
# Obtenga una clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
AGENT_MODEL_FLASH=gemini-2.5-flash
AGENT_MODEL_FLASH_LITE=gemini-2.5-flash-lite
# Caché de respuestas idénticas (segundos). 86400 = 24 h
AGENT_CACHE_TTL=86400
# Límite diario por IP (0 = sin límite propio del servidor)
AGENT_DAILY_LIMIT_PER_IP=40

# --- PostGIS / GeoDjango (F0) ---
DJANGO_USE_POSTGIS=1

# --- Panel admin — pruebas del sistema (/admin/pruebas) ---
# Ejecutar suite pytest desde la UI (solo desarrollo). Por defecto sigue a DJANGO_DEBUG.
# ALLOW_ADMIN_TEST_RUNNER=1  → fuerza habilitar el botón «Ejecutar suite»
# ALLOW_ADMIN_TEST_RUNNER=0  → deshabilita aunque DEBUG=1 (solo ver resultados previos)
# No requiere Node.js ni Java: los JSON de allure-results/ se muestran en la UI y en el reporte PDF.
# Windows (OSGeo4W): descomente y ajuste rutas si manage.py falla al importar gdal
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal312.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll
